---
const currentYear = new Date().getFullYear();
---

<footer style="border-top:1px solid var(--border-1); background:var(--bg-1);">
  <div style="max-width:1200px; margin:0 auto; padding:40px 56px;">
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
      <div style="display:flex; align-items:center; gap:24px; font-family:var(--font-mono); font-size:12px; color:var(--fg-4);">
        <span>© {currentYear} SUNHAYOUNG</span>
      </div>
      <div style="display:flex; align-items:center; gap:20px; font-family:var(--font-mono); font-size:12px;">
        <a href="https://github.com/hayohio-bit" target="_blank" rel="noopener noreferrer" style="color:var(--fg-4); text-decoration:none; transition:color 0.2s;" onmouseenter="this.style.color='var(--fg-1)'" onmouseleave="this.style.color='var(--fg-4)'">
          GitHub
        </a>
        <a href="https://ssunhy.com/" target="_blank" rel="noopener noreferrer" style="color:var(--fg-4); text-decoration:none; transition:color 0.2s;" onmouseenter="this.style.color='var(--fg-1)'" onmouseleave="this.style.color='var(--fg-4)'">
          Blog
        </a>
        <a href="/rss.xml" style="color:var(--fg-4); text-decoration:none; transition:color 0.2s;" onmouseenter="this.style.color='var(--fg-1)'" onmouseleave="this.style.color='var(--fg-4)'">
          RSS
        </a>
      </div>
    </div>
  </div>
</footer>
