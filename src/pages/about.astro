---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";
---

<html lang="ko" class="dark scroll-smooth">
  <head>
    <BaseHead
      title={`About — ${SITE_TITLE}`}
      description="백엔드 개발자 선하영의 전향 이유, 강점, 앞으로의 방향을 소개합니다."
    />
    <style>
      .about-hero {
        padding: 100px 56px 0;
        max-width: 1200px;
        margin: 0 auto;
      }
      .about-sect {
        max-width: 1200px;
        margin: 0 auto;
        padding: 80px 56px;
      }
      .strength-num {
        font-family: var(--font-mono);
        font-size: 48px;
        font-weight: 600;
        color: var(--accent-soft);
        letter-spacing: -0.03em;
        position: absolute;
        top: -8px;
        right: 8px;
      }
      .channel-card {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 16px;
        text-decoration: none;
        color: inherit;
      }
      .channel-card:hover {
        text-decoration: none;
      }
      .channel-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--r-md);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      @media (max-width: 768px) {
        .about-hero {
          padding: 64px 20px 0;
        }
        .about-sect {
          padding: 60px 20px;
        }
      }
    </style>
  </head>
  <body>
    <Header />

    <!-- Hero -->
    <div class="about-hero">
      <div class="ds-eyebrow">
        <span class="num">00</span><span class="ln"></span><span>about me</span>
      </div>
      <h1
        style="font-size:clamp(36px,5vw,56px); font-weight:700; letter-spacing:-0.03em; margin:10px 0 0;"
      >
        선하영<span style="color:var(--accent-text);">.</span>
      </h1>
      <p
        style="margin-top:14px; font-size:18px; color:var(--accent-text); font-family:var(--font-mono); font-weight:500;"
      >
        실무 도메인 이해력 × 프로세스 구조화 × 자기주도 실행력
      </p>
    </div>

    <!-- 전향 이유 -->
    <section class="about-sect" style="border-top:1px solid var(--border-1);">
      <div class="ds-eyebrow">
        <span class="num">01</span><span class="ln"></span><span>why dev</span>
      </div>
      <h2
        style="font-size:32px; font-weight:600; letter-spacing:-0.02em; margin:10px 0 24px;"
      >
        개발자로 전향한 이유<span style="color:var(--accent-text);">.</span>
      </h2>
      <div class="ds-card" style="padding:32px;">
        <p
          style="font-size:15px; color:var(--fg-2); line-height:1.75; margin:0;"
        >
          9년간 비서, 예산, 인허가 관리, 경영 진단 등 행정·경영지원 실무를
          하면서 항상 파편화된 데이터와 수작업의 불편함을 기록했습니다. 엑셀
          수식에서 시작해 VBA, 크롤링, HTML/CSS로 범위를 넓혀가며 문제 해결의
          쾌감을 경험했고, 결국 시스템 개선 의견이 실제 반영되는 과정을 보면서 <strong
            >"직접 만들어야겠다"</strong
          >는 확신으로 개발자 전환을 결심했습니다.
        </p>
      </div>
    </section>

    <!-- 강점 -->
    <section class="about-sect" style="border-top:1px solid var(--border-1);">
      <div class="ds-eyebrow">
        <span class="num">02</span><span class="ln"></span><span>strengths</span
        >
      </div>
      <h2
        style="font-size:32px; font-weight:600; letter-spacing:-0.02em; margin:10px 0 32px;"
      >
        강점<span style="color:var(--accent-text);">.</span>
      </h2>
      <div class="grid md:grid-cols-3 gap-4">
        {
          [
            {
              num: "01",
              title: "실무 도메인 전문성",
              desc: "9년간 현장에서 사용자의 Pain Point를 직접 경험했기에, 업무 로직을 정확히 파악하고 엣지 케이스에 강한 API를 설계합니다.",
            },
            {
              num: "02",
              title: "프로세스 구조화 역량",
              desc: "업무를 매뉴얼화하고 반복 작업을 자동화하던 습관이 시스템 설계 최적화로 연결되었습니다. 문제 정의 → 지표화 → 개선의 사이클을 자연스럽게 반복합니다.",
            },
            {
              num: "03",
              title: "자기주도 실행력",
              desc: "팀 프로젝트 종료 후에도 아쉬운 점을 주도적으로 파고들어 개선합니다. 일상에서 느끼는 불편함을 직접 도구로 만들어 해결하는 능동적인 개발자 마인드셋을 갖추고 있습니다.",
            },
          ].map((s) => (
            <div
              class="ds-card"
              style="padding:28px; position:relative; overflow:hidden;"
            >
              <span class="strength-num">{s.num}</span>
              <h3 style="font-size:18px; font-weight:600; margin:0 0 12px; color:var(--fg-1); position:relative;">
                {s.title}
              </h3>
              <p style="font-size:14px; color:var(--fg-3); line-height:1.65; margin:0; position:relative;">
                {s.desc}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 방향 -->
    <section class="about-sect" style="border-top:1px solid var(--border-1);">
      <div class="ds-eyebrow">
        <span class="num">03</span><span class="ln"></span><span>direction</span
        >
      </div>
      <h2
        style="font-size:32px; font-weight:600; letter-spacing:-0.02em; margin:10px 0 24px;"
      >
        앞으로의 방향<span style="color:var(--accent-text);">.</span>
      </h2>
      <div class="ds-card" style="padding:32px;">
        <p
          style="font-size:15px; color:var(--fg-2); line-height:1.75; margin:0 0 14px;"
        >
          어떤 일이든 <strong>'왜'</strong>에 대해 먼저 고민하고, 모르는 것이
          생기면 답을 찾을 때까지 파고듭니다. 비즈니스의 실제 요구사항을 깊이
          이해하고, 변화에 유연하게 대응할 수 있는 시스템을 만드는 개발자가 되고
          싶습니다.
        </p>
        <p
          style="font-size:15px; color:var(--fg-2); line-height:1.75; margin:0;"
        >
          <strong>Java · Spring Boot</strong> 생태계를 중심으로 안정적이고 확장 가능한
          백엔드 시스템을 구축하는 것이 목표입니다.
        </p>
      </div>
    </section>

    <!-- 채널 -->
    <section class="about-sect" style="border-top:1px solid var(--border-1);">
      <div class="ds-eyebrow">
        <span class="num">04</span><span class="ln"></span><span>channels</span>
      </div>
      <h2
        style="font-size:32px; font-weight:600; letter-spacing:-0.02em; margin:10px 0 32px;"
      >
        채널<span style="color:var(--accent-text);">.</span>
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          [
            {
              href: "/",
              icon: "📄",
              bg: "var(--accent-soft)",
              border: "var(--accent-line)",
              title: "개발 포트폴리오",
              desc: "이력서 · 자기소개서 · 프로젝트",
              external: false,
              isCurrent: true,
            },
            {
              href: "https://dev.ssunhy.com/",
              icon: "📝",
              bg: "rgba(249, 115, 22, 0.08)",
              border: "rgba(249, 115, 22, 0.2)",
              title: "블로그",
              desc: "TIL · WIL · 에러 해결 · 기술 학습 기록",
              external: true,
            },
            {
              href: "https://hayohio-bit.github.io/hayohio-portfolio/",
              icon: "🎨",
              bg: "rgba(99, 102, 241, 0.08)",
              border: "rgba(99, 102, 241, 0.2)",
              title: "디자인 포트폴리오",
              desc: "이전 직장 디자인 작업물 · UI/UX 경험 증거",
              external: true,
            },
            {
              href: "https://github.com/hayohio-bit",
              icon: "🐙",
              bg: "rgba(110, 84, 148, 0.08)",
              border: "rgba(110, 84, 148, 0.2)",
              title: "GitHub",
              desc: "소스 코드 · 커밋 히스토리 · 프로젝트 관리",
              external: true,
            },
          ].map((ch) => (
            <a
              href={ch.href}
              target={ch.external ? "_blank" : undefined}
              rel={ch.external ? "noopener noreferrer" : undefined}
              class="ds-card channel-card"
              style="padding:22px;"
            >
              <div
                class="channel-icon"
                style={`background:${ch.bg}; border:1px solid ${ch.border};`}
              >
                <span style="font-size:18px;">{ch.icon}</span>
              </div>
              <div>
                <h3 style="font-size:16px; font-weight:600; margin:0 0 4px; color:var(--fg-1); display:flex; align-items:center; gap:8px;">
                  {ch.title}
                  {ch.isCurrent && (
                    <span style="font-family:var(--font-mono); font-size:10px; font-weight:600; padding:2px 6px; background:var(--accent-soft); color:var(--accent-text); border-radius:var(--r-sm); text-transform:uppercase; letter-spacing:0.03em;">
                      This Site
                    </span>
                  )}
                </h3>
                <p style="font-size:13px; color:var(--fg-3); margin:0;">
                  {ch.desc}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Contact -->
    <section class="about-sect" style="border-top:1px solid var(--border-1);">
      <div class="ds-eyebrow">
        <span class="num">05</span><span class="ln"></span><span>contact</span>
      </div>
      <h2
        style="font-size:32px; font-weight:600; letter-spacing:-0.02em; margin:10px 0 24px;"
      >
        연락하기<span style="color:var(--accent-text);">.</span>
      </h2>
      <div class="ds-card" style="padding:28px;">
        <div class="flex items-center gap-3 mb-3">
          <svg
            class="w-5 h-5"
            style="color:var(--fg-3);"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <a
            href="mailto:hayohio@gmail.com"
            style="font-family:var(--font-mono); font-size:14px; color:var(--accent-text);"
            >hayohio@gmail.com</a
          >
        </div>
        <p style="font-size:14px; color:var(--fg-3); margin:0;">
          채용 관련 문의나 제안이 있으시다면 언제든 편하게 연락해 주세요.
        </p>
      </div>
    </section>

    <Footer />
  </body>
</html>
