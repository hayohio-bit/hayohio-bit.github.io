    <!-- Terminal typing animation -->
    <script>
      const SCRIPT = [
        { kind: "prompt", text: "$ ", speed: 0, delay: 500 },
        { kind: "cmd", text: "whoami", speed: 55 },
        { kind: "out", text: "\n선하영 · sun.hayoung", speed: 16, delay: 220 },
        { kind: "out", text: "\n", speed: 0, delay: 380 },
        { kind: "prompt", text: "\n$ ", speed: 0 },
        { kind: "cmd", text: "cat experience.json", speed: 50 },
        { kind: "out", text: "\n", speed: 0, delay: 200 },
        { kind: "out", text: '{\n  "years": ', speed: 14 },
        { kind: "num", text: "9", speed: 80, delay: 100 },
        { kind: "out", text: ',\n  "stack": ["', speed: 14 },
        { kind: "str", text: "Java", speed: 35 },
        { kind: "out", text: '", "', speed: 14 },
        { kind: "str", text: "Spring Boot", speed: 28 },
        { kind: "out", text: '", "', speed: 14 },
        { kind: "str", text: "JPA", speed: 35 },
        { kind: "out", text: '"],\n  "focus": "', speed: 14 },
        { kind: "str", text: "비즈니스 도메인 이해", speed: 22 },
        { kind: "out", text: '"\n}', speed: 14, delay: 250 },
        { kind: "prompt", text: "\n\n$ ", speed: 0 },
        { kind: "cmd", text: "echo $MOTTO", speed: 50 },
        { kind: "out", text: "\n", speed: 0, delay: 200 },
        { kind: "ok", text: "코드로 문제를 해결하는 개발자", speed: 45 },
        { kind: "prompt", text: "\n\n$ ", speed: 0 },
      ];

      const KIND_CLS = {
        prompt: "t-prompt",
        cmd: "t-cmd",
        out: "t-out",
        str: "t-str",
        num: "t-num",
        ok: "t-ok",
      };

      function runTypewriter() {
        const el = document.getElementById("terminal-output");
        if (!el) return;

        const flat = [];
        SCRIPT.forEach((seg) => {
          [...seg.text].forEach((ch, ci) => {
            flat.push({
              ch,
              kind: seg.kind,
              delay: ci === 0 ? seg.delay || 0 : 0,
              speed: seg.speed || 30,
            });
          });
        });

        let idx = 0;
        let html = "";
        let curKind = null;

        function tick() {
          if (idx >= flat.length) {
            setTimeout(() => {
              idx = 0;
              html = "";
              curKind = null;
              tick();
            }, 6000);
            return;
          }
          const c = flat[idx];
          if (c.kind !== curKind) {
            if (curKind) html += "</span>";
            html += `<span class="${KIND_CLS[c.kind] || "t-out"}">`;
            curKind = c.kind;
          }
          html +=
            c.ch === "\n"
              ? "\n"
              : c.ch.replace(/</g, "&lt;").replace(/>/g, "&gt;");
          el.innerHTML =
            html + (curKind ? "</span>" : "") + '<span class="caret"></span>';
          idx++;
          setTimeout(tick, c.delay + c.speed);
        }
        tick();
      }
      runTypewriter();
    </script>
