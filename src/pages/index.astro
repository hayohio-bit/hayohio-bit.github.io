---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<html lang="ko" class="dark scroll-smooth">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      /* ──── HERO ──── */
      .hero {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      .bg-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
      }
      .bg-glow {
        position: absolute;
        top: -25%;
        right: -10%;
        width: 70%;
        height: 95%;
        background: radial-gradient(
          ellipse at center,
          var(--accent-soft),
          transparent 65%
        );
        filter: blur(20px);
      }
      .bg-grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(var(--border-1) 1px, transparent 1px),
          linear-gradient(90deg, var(--border-1) 1px, transparent 1px);
        background-size: 64px 64px;
        mask-image: radial-gradient(
          ellipse 80% 80% at 30% 60%,
          black 30%,
          transparent 95%
        );
        -webkit-mask-image: radial-gradient(
          ellipse 80% 80% at 30% 60%,
          black 30%,
          transparent 95%
        );
        opacity: 0.7;
      }
      .hero-main {
        position: relative;
        flex: 1;
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        gap: 72px;
        padding: 90px 56px 80px;
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
      }
      .hero-left {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .hero-name {
        font-size: clamp(56px, 8vw, 96px);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1;
        margin: 0;
        color: var(--fg-1);
      }
      .hero-name .dot {
        color: var(--accent-text);
      }
      .hero-role {
        margin-top: 22px;
        font-family: var(--font-mono);
        font-size: 17px;
        color: var(--fg-2);
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
      }
      .hero-role .pipe {
        color: var(--fg-5);
        font-weight: 300;
      }
      .hero-role .tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--accent-text);
      }
      .hero-role .tag::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--accent);
      }
      .hero-sub {
        margin-top: 36px;
        font-size: 20px;
        line-height: 1.55;
        color: var(--fg-2);
        max-width: 28ch;
        letter-spacing: -0.01em;
        text-wrap: balance;
      }
      .hero-sub .em {
        color: var(--fg-1);
        font-weight: 600;
        background: linear-gradient(
          180deg,
          transparent 65%,
          var(--accent-soft) 65%
        );
        padding: 0 2px;
      }
      .hero-ctas {
        display: flex;
        gap: 12px;
        margin-top: 44px;
      }
      .hero-stats {
        margin-top: 64px;
        display: flex;
        gap: 44px;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--fg-4);
      }
      .hero-stats .item .k {
        display: block;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 6px;
      }
      .hero-stats .item .v {
        font-size: 22px;
        font-weight: 500;
        color: var(--fg-1);
        letter-spacing: -0.02em;
      }
      .hero-stats .item .v .unit {
        color: var(--fg-3);
        font-size: 13px;
        margin-left: 4px;
      }
      .hero-right {
        display: flex;
        align-items: center;
        min-width: 0;
      }

      /* Terminal */
      .terminal {
        width: 100%;
        background: var(--code-bg);
        border: 1px solid var(--border-2);
        border-radius: var(--r-lg);
        overflow: hidden;
        box-shadow: var(--shadow-2);
        position: relative;
      }
      .terminal::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.18),
          transparent
        );
      }
      .term-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(255, 255, 255, 0.02);
      }
      .term-dots {
        display: flex;
        gap: 7px;
      }
      .term-dots span {
        width: 10px;
        height: 10px;
        border-radius: 99px;
      }
      .term-dots .d1,
      .term-dots .d2 {
        background: #3a4150;
      }
      .term-dots .d3 {
        background: var(--accent);
      }
      .term-bar .tname {
        font: 500 12px/1 var(--font-mono);
        color: #8a93a4;
      }
      .term-bar .tmeta {
        margin-left: auto;
        font: 12px/1 var(--font-mono);
        color: #5a6373;
      }
      .term-body {
        padding: 26px 28px 28px;
        min-height: 320px;
        font-family: var(--font-mono);
        font-size: 14px;
        line-height: 1.8;
        color: var(--code-fg);
        white-space: pre-wrap;
        word-break: break-word;
      }
      .t-prompt {
        color: var(--code-accent);
      }
      .t-cmd {
        color: #f4f6fb;
      }
      .t-out {
        color: #8a93a4;
      }
      .t-str {
        color: #f7c08a;
      }
      .t-num {
        color: #f59e0b;
      }
      .t-ok {
        color: #6ee7b7;
      }
      .caret {
        display: inline-block;
        width: 9px;
        height: 1.05em;
        background: var(--code-accent);
        vertical-align: text-bottom;
        margin-left: 1px;
        animation: blink 1.05s steps(2, end) infinite;
      }

      /* Scroll Hint */
      .scroll-hint {
        position: relative;
        text-align: center;
        padding-bottom: 36px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--fg-4);
      }
      .scroll-hint .ar {
        display: block;
        margin: 10px auto 0;
        width: 1px;
        height: 28px;
        background: linear-gradient(180deg, var(--border-3), transparent);
        animation: drop 2s ease-in-out infinite;
      }

      /* Sections */
      .sect {
        max-width: 1200px;
        margin: 0 auto;
        padding: 100px 56px;
      }
      .sect-head {
        margin-bottom: 56px;
      }
      .sect-title {
        font-size: 48px;
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.05;
        margin: 10px 0 0;
      }
      .sect-title .dot {
        color: var(--accent-text);
      }
      .sect-sub {
        margin-top: 14px;
        font-size: 16px;
        color: var(--fg-3);
        max-width: 52ch;
        line-height: 1.55;
      }

      /* Skill cluster card */
      .skill-card {
        display: grid;
        grid-template-columns: 140px 110px 1fr;
        gap: 24px;
        align-items: center;
      }
      .skill-cat {
        font-size: 18px;
        font-weight: 600;
        margin-top: 4px;
      }
      .skill-level {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--accent-text);
        margin-top: 6px;
      }

      /* Project preview card */
      .proj-preview {
        position: relative;
        cursor: pointer;
        isolation: isolate;
        text-decoration: none;
        color: inherit;
      }
      .proj-preview::after {
        content: "";
        position: absolute;
        inset: -40% -40% auto auto;
        width: 70%;
        height: 70%;
        background: radial-gradient(
          circle,
          var(--accent-soft),
          transparent 60%
        );
        opacity: 0;
        transition: opacity 0.35s;
        pointer-events: none;
        z-index: 0;
      }
      .proj-preview:hover::after {
        opacity: 1;
      }
      .proj-preview > * {
        position: relative;
        z-index: 1;
      }
      .proj-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border-1);
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--fg-4);
      }
      .proj-foot .go {
        color: var(--fg-3);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition:
          color 0.2s,
          transform 0.2s;
      }
      .proj-preview:hover .go {
        color: var(--accent-text);
        transform: translateX(2px);
      }

      /* Contact */
      .contact-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 22px;
        border-radius: var(--r-md);
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--fg-2);
        background: var(--bg-1);
        border: 1px solid var(--border-2);
        text-decoration: none;
        transition:
          border-color 0.2s,
          color 0.2s,
          transform 0.2s;
      }
      .contact-link:hover {
        border-color: var(--accent-line);
        color: var(--fg-1);
        transform: translateY(-2px);
        text-decoration: none;
      }

      @media (max-width: 1100px) {
        .hero-main {
          grid-template-columns: 1fr;
          gap: 56px;
          padding: 64px 32px;
        }
        .hero-name {
          font-size: 72px;
        }
        .sect {
          padding: 80px 32px;
        }
      }
      @media (max-width: 640px) {
        .hero-name {
          font-size: 48px;
        }
        .hero-sub {
          font-size: 18px;
        }
        .hero-stats {
          gap: 28px;
        }
        .sect {
          padding: 64px 20px;
        }
        .sect-title {
          font-size: 32px;
        }
        .skill-card {
          grid-template-columns: 1fr;
          gap: 12px;
        }
      }
    </style>
  </head>
  <body>
    <Header />

    <!-- ════════ HERO ════════ -->
    <section class="hero">
      <div class="bg-layer">
        <div class="bg-glow"></div>
        <div class="bg-grid"></div>
      </div>

      <div class="hero-main">
        <div class="hero-left">
          <div class="ds-eyebrow animate-fade-in-up">
            <span class="num">01</span>
            <span class="ln"></span>
            <span>introduction</span>
          </div>

          <h1 class="hero-name animate-fade-in-up">
            선하영<span class="dot">.</span>
          </h1>

          <div class="hero-role animate-fade-in-up-d1">
            <span>Java</span>
            <span class="pipe">·</span>
            <span>Spring Boot</span>
            <span class="pipe">·</span>
            <span class="tag">백엔드 개발자</span>
          </div>

          <p class="hero-sub animate-fade-in-up-d1">
            <span class="em">9년</span>의 비즈니스 실무 경험으로<br />
            <span class="em">도메인을 이해하는</span> 개발자.
          </p>

          <div class="hero-ctas animate-fade-in-up-d2">
            <a href="/projects" class="ds-btn primary"
              >프로젝트 보기 <span class="arr">→</span>
            </a>
            <a href="/resume" class="ds-btn ghost"
              >이력서 보기 <span class="arr">↗</span>
            </a>
          </div>

          <div class="hero-stats animate-fade-in-up-d3">
            <div class="item">
              <span class="k">core stack</span>
              <span class="v">Java<span class="unit"> / Spring</span></span>
            </div>
            <div class="item">
              <span class="k">bootcamp</span>
              <span class="v">1,140<span class="unit">h</span></span>
            </div>
            <div class="item">
              <span class="k">domain exp</span>
              <span class="v">9<span class="unit">yrs</span></span>
            </div>
          </div>
        </div>

        <div class="hero-right animate-fade-in-up-d2">
          <div class="terminal">
            <div class="term-bar">
              <div class="term-dots">
                <span class="d1"></span><span class="d2"></span><span class="d3"
                ></span>
              </div>
              <span class="tname">~/sun.hayoung — zsh</span>
              <span class="tmeta">80 × 24</span>
            </div>
            <div class="term-body" id="terminal-output">
              <span class="caret"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="scroll-hint">scroll<span class="ar"></span></div>
    </section>

    <!-- ════════ ABOUT BRIEF ════════ -->
    <section class="sect" style="border-top:1px solid var(--border-1);">
      <div class="sect-head">
        <div class="ds-eyebrow">
          <span class="num">02</span><span class="ln"></span><span>about</span>
        </div>
        <h2 class="sect-title">
          비즈니스를 아는 개발자<span class="dot">.</span>
        </h2>
        <p class="sect-sub">
          9년간의 사무·기획 실무에서 업무 프로세스의 구조화와 데이터 무결성의
          중요성을 체득했습니다.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {
          [
            {
              icon: "💻",
              title: "백엔드 개발",
              desc: "Java 21 · Spring Boot 3.x · JPA · MyBatis 기반 REST API 설계 및 AWS 실배포",
            },
            {
              icon: "⚙️",
              title: "인프라 · DevOps",
              desc: "Docker · GitHub Actions CI/CD 파이프라인 · Nginx 리버스 프록시 구축",
            },
            {
              icon: "📋",
              title: "도메인 이해력",
              desc: "9년간의 비즈니스 실무 경험으로 요구사항을 코드로 전환, 엣지 케이스에 강한 설계",
            },
          ].map((item) => (
            <div class="ds-card" style="padding:24px;">
              <div style="font-size:28px; margin-bottom:16px;">{item.icon}</div>
              <h4 style="font-size:18px; font-weight:600; margin:0 0 8px; color:var(--fg-1);">
                {item.title}
              </h4>
              <p style="font-size:14px; color:var(--fg-3); margin:0; line-height:1.6;">
                {item.desc}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ════════ TECH STACK ════════ -->
    <section class="sect" style="border-top:1px solid var(--border-1);">
      <div class="sect-head">
        <div class="ds-eyebrow">
          <span class="num">03</span><span class="ln"></span><span
            >tech stack</span
          >
        </div>
        <h2 class="sect-title">기술 스택<span class="dot">.</span></h2>
      </div>
      <div class="flex flex-col gap-4">
        {
          [
            {
              cat: "Core",
              level: "Daily driver",
              items: [
                "Java 21",
                "Spring Boot 3.x",
                "JPA / Hibernate",
                "MyBatis",
              ],
            },
            {
              cat: "Data",
              level: "Production",
              items: ["MySQL 8", "PostgreSQL", "Redis", "PostGIS"],
            },
            {
              cat: "Infra",
              level: "Comfortable",
              items: ["AWS EC2/S3", "Docker", "GitHub Actions", "Nginx"],
            },
            {
              cat: "Frontend",
              level: "Functional",
              items: ["React 18", "TypeScript", "HTML/CSS", "Vite"],
            },
          ].map((g) => (
            <div class="ds-card skill-card" style="padding:22px;">
              <div>
                <div style="font-family:var(--font-mono); font-size:10px; color:var(--fg-4); letter-spacing:.12em; text-transform:uppercase;">
                  category
                </div>
                <div class="skill-cat">{g.cat}</div>
              </div>
              <div>
                <div style="font-family:var(--font-mono); font-size:10px; color:var(--fg-4); letter-spacing:.12em; text-transform:uppercase;">
                  level
                </div>
                <div class="skill-level">{g.level}</div>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {g.items.map((i) => (
                  <span class="ds-chip">{i}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ════════ FEATURED PROJECTS ════════ -->
    <section class="sect" style="border-top:1px solid var(--border-1);">
      <div class="sect-head">
        <div class="ds-eyebrow">
          <span class="num">04</span><span class="ln"></span><span
            >selected work</span
          >
        </div>
        <h2 class="sect-title">만든 것들<span class="dot">.</span></h2>
        <p class="sect-sub">기술적 고민과 배움을 담은 결과물들입니다.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        {
          [
            {
              name: "DayPoo",
              ko: "위치 기반 AI 헬스케어",
              desc: "전국 5만 건 공공 화장실 데이터를 지도로 시각화 + AI 건강 인사이트 제공. Virtual Threads, PostGIS, Redis 다목적 활용",
              techs: ["Java 21", "Spring Boot", "PostGIS", "Redis", "Docker"],
              period: "2026.03 ~ 04",
              href: "/projects#daypoo",
            },
            {
              name: "SyncBridge",
              ko: "IT-비IT 협업 플랫폼",
              desc: "Spring AI로 직무별 용어 자동 번역·캐싱. DDD 설계 + WebSocket 실시간 알림 + 역할별 칸반/리스트 뷰",
              techs: ["Spring AI", "WebSocket", "React 19", "Docker"],
              period: "2026.04 ~",
              href: "/projects#syncbridge",
            },
            {
              name: "KnotNote",
              ko: "연결 중심 지식 관리",
              desc: "NoteLink 양방향 연결 + NoteEmbedding AI 확장 설계. 2종 에디터 직접 구현. Swagger 문서화",
              techs: ["Spring Boot", "JPA", "React 18", "JWT"],
              period: "2026.04 ~",
              href: "/projects#knotnote",
            },
            {
              name: "Spring MVC Migration",
              ko: "왜 Spring이 필요한가",
              desc: "JSP/Servlet Model2 → Spring MVC 6.2 + MyBatis 계층형 아키텍처 직접 마이그레이션. Docker 배포",
              techs: ["Spring MVC", "MyBatis", "Security", "Docker"],
              period: "2025.12 ~ 26.01",
              href: "/projects#spring-mvc-migration",
            },
            {
              name: "Creative Archive",
              ko: "디자인 자산물 아카이빙",
              desc: "Redux Toolkit 기반 카탈로그 포트폴리오. createSelector 메모이제이션, 다크/라이트 모드",
              techs: ["React 18", "Redux Toolkit", "Vite"],
              period: "2025.12",
              href: "/projects#creative-archive",
            },
            {
              name: "62댕냥",
              ko: "유기동물 입양 매칭",
              desc: "공공데이터포털 API 증분 동기화 + OAuth 2.0 백채널 인증. 쇼핑몰→비영리 도메인 재해석",
              techs: ["Spring Boot", "JPA", "AWS", "React"],
              period: "2026.02",
              href: "/projects#62dangnyang",
            },
          ].map((p, i) => (
            <a
              href={p.href}
              class="ds-card proj-preview"
              style="padding:28px; display:flex; flex-direction:column;"
            >
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class="ds-badge">{i < 3 ? "★ Featured" : "Project"}</span>
                <span style="font-family:var(--font-mono); font-size:11px; color:var(--fg-4);">
                  PROJECT · {String(i + 1).padStart(2, "0")}
                </span>
              </div>
              <h3 style="font-size:22px; font-weight:600; letter-spacing:-0.015em; margin:0 0 4px; color:var(--fg-1);">
                {p.name}{" "}
                <span style="font-size:14px; font-weight:400; color:var(--fg-3);">
                  — {p.ko}
                </span>
              </h3>
              <p style="font-size:14px; color:var(--fg-3); line-height:1.55; margin:10px 0 0; max-width:42ch;">
                {p.desc}
              </p>
              <div class="flex flex-wrap gap-1.5 mt-auto pt-4">
                {p.techs.map((t) => (
                  <span class="ds-chip">{t}</span>
                ))}
              </div>
              <div class="proj-foot">
                <span>{p.period}</span>
                <span class="go">
                  Case study{" "}
                  <span style="font-family:var(--font-mono);">→</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
      <div class="text-center mt-12">
        <a href="/projects" class="ds-btn ghost"
          >전체 프로젝트 보기 ({8}개) <span class="arr">→</span>
        </a>
      </div>
    </section>

    <!-- ════════ CONTACT ════════ -->
    <section class="sect" style="border-top:1px solid var(--border-1);">
      <div class="sect-head">
