---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";
import { PROJECTS } from "../data/projects";
import { PROJECT_DETAILS } from "../data/projectDetails";
import "../styles/project-detail.css";
---

<html lang="ko" class="dark scroll-smooth">
<head>
  <BaseHead title={`프로젝트 — ${SITE_TITLE}`} description="백엔드 개발자 선하영의 프로젝트 포트폴리오입니다." />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
  <style>
    .projects-hero{padding:100px 56px 60px;max-width:1200px;margin:0 auto}
    .bento{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;max-width:1200px;margin:0 auto;padding:0 56px 100px}
    .bento-featured{grid-column:span 2}
    .project-num{font-family:var(--font-mono);font-size:10px;color:var(--fg-4);letter-spacing:.12em}
    .project-title{font-size:24px;font-weight:600;letter-spacing:-0.015em;margin:8px 0 0;color:var(--fg-1)}
    .project-desc{font-size:14px;color:var(--fg-3);line-height:1.65;margin:10px 0 0;word-break:keep-all;overflow-wrap:break-word}
    .project-role{font-family:var(--font-mono);font-size:12px;color:var(--accent-text);margin-top:6px}
    .project-challenge{margin-top:16px;padding:14px 18px;background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.15);border-radius:var(--r-md);font-size:13px;line-height:1.55;color:var(--fg-2)}
    .project-challenge strong{color:var(--warn);font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;display:block;margin-bottom:6px}
    .project-links{display:flex;gap:12px;margin-top:18px}
    .project-link{font-family:var(--font-mono);font-size:12px;color:var(--fg-3);display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:var(--r-sm);background:var(--tint-1);border:1px solid var(--border-2);text-decoration:none;transition:all .2s}
    .project-link:hover{border-color:var(--accent-line);color:var(--fg-1);text-decoration:none}
    .blog-cta{max-width:1200px;margin:0 auto;padding:0 56px 100px}
    .blog-cta-inner{display:flex;align-items:center;justify-content:space-between;padding:28px 32px;border-radius:var(--r-lg);background:var(--bg-1);border:1px solid var(--border-1)}
    .card-clickable{cursor:pointer;transition:transform .28s cubic-bezier(.2,.7,.2,1),border-color .28s,box-shadow .28s}
    .card-clickable:hover{transform:translateY(-3px);border-color:var(--accent-line);box-shadow:var(--shadow-hover)}
    .card-case-study{font-family:var(--font-mono);font-size:11px;color:var(--accent-text);margin-top:14px;padding-top:12px;border-top:1px solid var(--border-1);display:flex;justify-content:space-between;align-items:center}
    @media(max-width:768px){
      .projects-hero{padding:64px 20px 40px}
      .bento{grid-template-columns:1fr;padding:0 20px 64px}
      .bento-featured{grid-column:span 1}
      .blog-cta{padding:0 20px 64px}
      .blog-cta-inner{flex-direction:column;gap:16px;text-align:center}
    }
  </style>
</head>
<body>
  <Header />

  <!-- ═══ PROJECT LIST VIEW ═══ -->
  <div id="projects-list">
    <div class="projects-hero">
      <div class="ds-eyebrow">
        <span class="num">00</span><span class="ln"></span><span>projects</span>
      </div>
      <h1 style="font-size:clamp(36px,5vw,56px);font-weight:700;letter-spacing:-0.03em;margin:10px 0 0;">
        만든 것들<span style="color:var(--accent-text);">.</span>
      </h1>
      <p style="margin-top:14px;font-size:16px;color:var(--fg-3);max-width:52ch;line-height:1.55;word-break:keep-all;">
        부트캠프와 개인 프로젝트를 통해 만든 서비스들입니다.<br/>모든 프로젝트는 <strong style="color:var(--fg-1);">실제 서버 배포 과정을 거쳐 완성</strong>되었습니다.
      </p>
      <div class="ds-stat-grid" style="margin-top:44px;max-width:480px;">
        <div class="ds-stat-cell">
          <span class="ds-stat-k">total</span>
          <span class="ds-stat-v">{PROJECTS.length}</span>
        </div>
        <div class="ds-stat-cell">
          <span class="ds-stat-k">deployed</span>
          <span class="ds-stat-v">{PROJECTS.filter(p => p.demoUrl).length}</span>
        </div>
        <div class="ds-stat-cell">
          <span class="ds-stat-k">featured</span>
          <span class="ds-stat-v">{PROJECTS.filter(p => p.featured).length}</span>
        </div>
      </div>
    </div>

    <div class="bento">
      {PROJECTS.map((p, i) => (
        <div
          class={`ds-card card-clickable ${p.featured ? "bento-featured" : ""}`}
          style="padding:28px;"
          data-slug={p.slug}
          role="button"
          tabindex="0"
          aria-label={`${p.title} 프로젝트 상세 보기`}
        >
          <div class="flex items-center justify-between gap-3 mb-2">
            <span class={`ds-badge ${p.featured ? "" : "neutral"}`}>
              {p.featured ? "★ Featured" : p.type}
            </span>
            <span class="project-num">PROJECT · {String(i+1).padStart(2,"0")}</span>
          </div>
          <h2 class="project-title">{p.title}</h2>
          <div class="project-role">{p.type} · {p.role}</div>
          <p class="project-desc">{p.description}</p>
          {p.challenge && (
            <div class="project-challenge">
              <strong>💡 Challenge</strong>
              {p.challenge}
            </div>
          )}
          <div class="flex flex-wrap gap-1.5" style="margin-top:16px;">
            {p.techStack.map((t) => <span class="ds-chip">{t}</span>)}
          </div>
          <div class="card-case-study">
            <span>{p.period}</span>
            <span>Case study →</span>
          </div>
        </div>
      ))}
    </div>

    <div class="blog-cta">
      <div class="blog-cta-inner">
        <div>
          <p style="font-size:13px;color:var(--fg-4);margin:0;">각 프로젝트 개발 과정의 상세한 기술 기록은 기술 블로그에서 확인할 수 있습니다.</p>
        </div>
        <a href="https://dev.ssunhy.com/" target="_blank" rel="noopener noreferrer" class="ds-btn ghost" style="white-space:nowrap; padding:10px 16px; font-size:13px;">
          기술 블로그 <span class="arr">↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ═══ PROJECT DETAIL VIEW ═══ -->
  <div id="project-detail" style="display:none;">
    {PROJECTS.map((p) => {
      const d = PROJECT_DETAILS[p.slug];
      if (!d) return null;
      return (
        <div class="pd-detail-content" data-detail-slug={p.slug} style="display:none;">
          <div class="pd-wrap">
            <button class="pd-back" aria-label="프로젝트 목록으로 돌아가기" onclick="backToProjects()">← 프로젝트 목록으로</button>
            
            {/* HERO */}
            <div class="pd-hero">
              <div class="ds-eyebrow">
                <span class="num">{String(PROJECTS.indexOf(p)+1).padStart(2,"0")}</span><span class="ln"></span><span>project</span>
              </div>
              <h1>{p.title}<span style="color:var(--accent-text);">.</span></h1>
              <p class="pd-tagline">{d.tagline}</p>
              <div class="flex flex-wrap gap-1.5" style="margin-bottom:20px;">
                {p.techStack.map((t: string) => <span class="ds-chip">{t}</span>)}
              </div>
              <div class="pd-meta">
                <div class="pd-meta-cell"><span class="pd-meta-k">period</span><span class="pd-meta-v">{p.period}</span></div>
                <div class="pd-meta-cell"><span class="pd-meta-k">type</span><span class="pd-meta-v">{p.type}</span></div>
                <div class="pd-meta-cell"><span class="pd-meta-k">role</span><span class="pd-meta-v">{p.role}</span></div>
              </div>
              <div class="pd-actions">
                {p.githubUrl && <a href={p.githubUrl} target="_blank" rel="noopener noreferrer" class="project-link" aria-label={`${p.title} GitHub 저장소 (새 창)`}><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg> GitHub ↗</a>}
                {p.demoUrl && <a href={p.demoUrl} target="_blank" rel="noopener noreferrer" class="project-link" style="border-color:var(--accent-line);color:var(--accent-text);" aria-label={`${p.title} Live Demo (새 창)`} title={p.slug === 'spring-mvc' ? "무료 호스팅(Render) 환경으로 인해 첫 접속 시 30초~50초의 지연이 발생할 수 있습니다." : undefined}>Live Demo ↗</a>}
              </div>
            </div>

            <div class="pd-content-grid">
              <div class="pd-main-col">
            {/* 01 OVERVIEW */}
            <section class="pd-section" aria-labelledby={`ov-${p.slug}`}>
              <div class="pd-section-num">01</div>
              <h2 id={`ov-${p.slug}`}>Overview</h2>
              <div class="pd-overview-grid">
                <div class="pd-overview-card"><h3>🔍 Problem</h3><p>{d.overview.problem}</p></div>
                <div class="pd-overview-card"><h3>💡 Why I Built This</h3><p>{d.overview.whyBuilt}</p></div>
                <div class="pd-overview-card"><h3>⚡ Key Features</h3><ol style="padding-left:18px;margin:0;">{d.overview.features.map((f: string) => <li>{f}</li>)}</ol></div>
              </div>
            </section>

            {/* 02 TECH STACK */}
            <section class="pd-section" aria-labelledby={`ts-${p.slug}`}>
              <div class="pd-section-num">02</div>
              <h2 id={`ts-${p.slug}`}>Tech Stack & Architecture</h2>
              <table class="pd-tech-table">
                <thead><tr><th>Category</th><th>Technology</th><th>선택 이유</th></tr></thead>
                <tbody>
                  {d.techCategories.map((cat: any) => cat.items.map((item: any, idx: number) => (
                    <tr>
                      {idx === 0 && <td rowspan={cat.items.length} style="font-weight:600;color:var(--accent-text)">{cat.name}</td>}
                      <td>{item.n}</td><td style="color:var(--fg-3)">{item.r}</td>
                    </tr>
                  )))}
                </tbody>
              </table>
              <div class="pd-mermaid"><pre class="mermaid">{d.archMermaid}</pre></div>
            </section>

            {/* 03 ERD / DATA FLOW */}
            <section class="pd-section" aria-labelledby={`erd-${p.slug}`}>
              <div class="pd-section-num">03</div>
              <h2 id={`erd-${p.slug}`}>{d.erdMermaid ? 'ERD — 데이터 모델' : 'Data Flow'}</h2>
              <div class="pd-mermaid"><pre class="mermaid">{d.erdMermaid || d.dataFlowMermaid}</pre></div>
            </section>

            {/* 04 USE CASE */}
            <section class="pd-section" aria-labelledby={`uc-${p.slug}`}>
              <div class="pd-section-num">04</div>
              <h2 id={`uc-${p.slug}`}>Use Case — 핵심 플로우</h2>
              {d.useCases.map((uc: any) => (
                <div>
                  <h3 style="font-size:16px;font-weight:600;margin:0 0 12px;color:var(--fg-1)">{uc.title}</h3>
                  <div class="pd-mermaid"><pre class="mermaid">{uc.mermaid}</pre></div>
                </div>
              ))}
            </section>

            {/* 05 TIMELINE */}
            <section class="pd-section" aria-labelledby={`tl-${p.slug}`}>
              <div class="pd-section-num">05</div>
              <h2 id={`tl-${p.slug}`}>Development Journey</h2>
              <div class="pd-timeline">
                {d.timeline.map((t: any) => (
                  <div class="pd-tl-item">
                    <div class="pd-tl-week">{t.week}</div>
                    <div class="pd-tl-ms">{t.milestone}</div>
                    <div class="pd-tl-desc">{t.desc}</div>
                  </div>
                ))}
              </div>
            </section>

            {/* 06 KEY IMPLEMENTATION */}
            <section class="pd-section" aria-labelledby={`ki-${p.slug}`}>
              <div class="pd-section-num">06</div>
              <h2 id={`ki-${p.slug}`}>Key Implementation</h2>
              {d.keyImpls.map((impl: any) => (
                <div class="pd-impl-card">
                  <h3>{impl.title}</h3>
                  <p>{impl.summary}</p>
                  {impl.code && (
                    <div role="region" aria-label="코드 예시">
                      <pre style="background:var(--code-bg);border:1px solid var(--border-1);border-radius:var(--r-md);padding:16px;overflow-x:auto;margin:0"><code class={`language-${impl.code.lang}`}>{impl.code.snippet}</code></pre>
                    </div>
                  )}
                </div>
              ))}
            </section>

            {/* 07 SCREENSHOTS */}
            <section class="pd-section" aria-labelledby={`ss-${p.slug}`}>
              <div class="pd-section-num">07</div>
              <h2 id={`ss-${p.slug}`}>Screenshots</h2>
              <div class="pd-ss-grid">
                <div class="pd-ss-item">[ 메인 화면 ]</div>
                <div class="pd-ss-item">[ 핵심 기능 화면 ]</div>
                <div class="pd-ss-item">[ 결과 화면 ]</div>
              </div>
              <p style="font-size:12px;color:var(--fg-4);margin-top:12px;text-align:center;">
                스크린샷은 준비 중입니다. <a href={p.demoUrl} target="_blank" rel="noopener noreferrer">Live Demo</a>에서 실제 서비스를 확인할 수 있습니다.
              </p>
            </section>

            {/* 08 TROUBLESHOOTING */}
            <section class="pd-section" aria-labelledby={`tr-${p.slug}`}>
              <div class="pd-section-num">08</div>
              <h2 id={`tr-${p.slug}`}>Troubleshooting</h2>
              {d.troubleshooting.map((t: any, idx: number) => (
                <details class="pd-trouble" open={idx === 0}>
                  <summary>🔴 {t.problem}</summary>
                  <div class="pd-trouble-body">
                    <div class="pd-trouble-row problem"><div><div class="pd-trouble-label">Problem</div><div style="color:var(--fg-2)">{t.problem}</div></div></div>
                    <div class="pd-trouble-row cause"><div><div class="pd-trouble-label">Cause</div><div style="color:var(--fg-2)">{t.cause}</div></div></div>
                    <div class="pd-trouble-row solution"><div><div class="pd-trouble-label">Solution</div><div style="color:var(--fg-2)">{t.solution}</div></div></div>
                    <div class="pd-trouble-row learned"><div><div class="pd-trouble-label">Learned</div><div style="color:var(--fg-2)">{t.learned}</div></div></div>
                  </div>
                </details>
              ))}
            </section>

            {/* 09 RETROSPECTIVE */}
            <section class="pd-section" aria-labelledby={`re-${p.slug}`}>
              <div class="pd-section-num">09</div>
              <h2 id={`re-${p.slug}`}>Retrospective</h2>
              <div class="pd-retro-grid">
                <div class="pd-retro-card good"><h3>✅ 잘한 점</h3><ul style="padding-left:18px;margin:0">{d.retro.good.map((g: string) => <li>{g}</li>)}</ul></div>
                <div class="pd-retro-card bad"><h3>⚠️ 아쉬운 점</h3><ul style="padding-left:18px;margin:0">{d.retro.bad.map((b: string) => <li>{b}</li>)}</ul></div>
                <div class="pd-retro-card next"><h3>🚀 개선 방향</h3><ul style="padding-left:18px;margin:0">{d.retro.next.map((n: string) => <li>{n}</li>)}</ul></div>
              </div>
              </div>
            </section>

              </div>
              <aside class="pd-sidebar-col">
                <nav class="pd-toc">
                  <div class="pd-toc-title">On this page</div>
                  <ul>
                    <li><a href={`#ov-${p.slug}`} class="toc-link">Overview</a></li>
                    <li><a href={`#ts-${p.slug}`} class="toc-link">Tech Stack</a></li>
                    {d.erdMermaid || d.dataFlowMermaid ? <li><a href={`#erd-${p.slug}`} class="toc-link">Data Model</a></li> : null}
                    {d.useCases && d.useCases.length > 0 ? <li><a href={`#uc-${p.slug}`} class="toc-link">Use Case</a></li> : null}
                    <li><a href={`#tl-${p.slug}`} class="toc-link">Timeline</a></li>
                    <li><a href={`#ki-${p.slug}`} class="toc-link">Implementation</a></li>
                    <li><a href={`#ss-${p.slug}`} class="toc-link">Screenshots</a></li>
                    {d.troubleshooting && d.troubleshooting.length > 0 ? <li><a href={`#tr-${p.slug}`} class="toc-link">Troubleshooting</a></li> : null}
                    {d.retro ? <li><a href={`#re-${p.slug}`} class="toc-link">Retrospective</a></li> : null}
                  </ul>
                </nav>
              </aside>
            </div>

          </div>
        </div>
      );
    })}
  </div>

  <Footer />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-java.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-xml-doc.min.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/svg-pan-zoom@3.6.1/dist/svg-pan-zoom.min.js" is:inline></script>
  <script type="module" is:inline>
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ 
      startOnLoad: false, 
      theme: 'base',
      themeVariables: {
        background: 'transparent'
      }
    });
    window.__mermaid = mermaid;
    window.__mermaidReady = true;
    // Initial route check
    handleRoute();
  </script>

  <script is:inline>
    const validSlugs = ['daypoo','syncbridge','knotnote','spring-mvc','creative-archive','62dangnyang','mermaid-studio','portmanager'];

    function showProjectDetail(slug) {
      document.getElementById('projects-list').style.display = 'none';
      document.getElementById('project-detail').style.display = 'block';
      // Hide all detail contents
      document.querySelectorAll('.pd-detail-content').forEach(el => el.style.display = 'none');
      // Show target
      const target = document.querySelector('[data-detail-slug="'+slug+'"]');
      if (target) {
        target.style.display = 'block';
        // Render mermaid
        if (window.__mermaidReady) {
          const mermaidNodes = Array.from(target.querySelectorAll('.mermaid')).filter(el => !el.getAttribute('data-processed'));
          if (mermaidNodes.length > 0) {
            window.__mermaid.run({ nodes: mermaidNodes }).then(() => {
              mermaidNodes.forEach(el => {
                const svg = el.querySelector('svg');
                if (svg && window.svgPanZoom) {
                  requestAnimationFrame(() => {
                    const viewBox = svg.getAttribute('viewBox');
                    let height = 400;
                    const container = el.closest('.pd-mermaid');
                    if (viewBox && container) {
                      const parts = viewBox.split(/[\s,]+/).filter(Boolean).map(Number);
                      const w = parts[2];
                      let h = parts[3];
                      if (w && h) {
                        // Mermaid가 커스텀 폰트 높이를 과소평가하여 하단이 잘리는 현상 방지 (하단 여백 40 추가)
                        h += 40;
                        svg.setAttribute('viewBox', `${parts[0]} ${parts[1]} ${w} ${h}`);
                        
                        const availableWidth = (container.clientWidth || 800) - 40;
                        // 최대 1.1배까지만 커지도록 제한하여 글씨가 과도하게 커지는 현상 방지
                        const scale = Math.min(availableWidth / w, 1.1);
                        let targetHeight = h * scale;
                        // 세로로 긴 다이어그램이 너무 작아지지 않도록 최대 높이를 700px까지 넉넉하게 허용
                        height = Math.max(150, Math.min(targetHeight, 700));
                      }
                    }
                    if (container) {
                      container.style.height = (height + 40) + 'px';
                      container.style.overflow = 'hidden';
                      container.style.position = 'relative';
                    }
                    el.style.width = '100%';
                    el.style.height = '100%';
                    el.style.margin = '0';
                    el.style.padding = '0';
                    el.style.overflow = 'visible';
                    svg.style.width = '100%';
                    svg.style.height = '100%';
                    svg.style.maxWidth = 'none';
                    const pz = window.svgPanZoom(svg, {
                      zoomEnabled: true,
                      controlIconsEnabled: false,
                      fit: true,
                      contain: true,
                      center: true,
                      minZoom: 0.1,
                      maxZoom: 10
                    });

                    // Custom sleek controls
                    if (container) {
                      const controls = document.createElement('div');
                      controls.className = 'pd-zoom-controls';
                      controls.innerHTML = `
                        <button class="pd-zc-btn" data-action="in" title="Zoom In">+</button>
                        <button class="pd-zc-btn" data-action="reset" title="Reset Zoom">↺</button>
                        <button class="pd-zc-btn" data-action="out" title="Zoom Out">−</button>
                      `;
                      container.appendChild(controls);

                      controls.addEventListener('click', (e) => {
                        const action = e.target.getAttribute('data-action');
                        if (action === 'in') pz.zoomIn();
                        if (action === 'out') pz.zoomOut();
                        if (action === 'reset') {
                          pz.resetZoom();
                          pz.center();
                        }
                      });
                    }
                  });
                }
              });
            }).catch(e => console.error('Mermaid render error', e));
          }
        }
        // Highlight code
        if (window.Prism) Prism.highlightAllUnder(target);
        // Observe sections
        observeSections(target);
        // Observe timeline items
        observeTimeline(target);
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function backToProjects() {
      history.pushState(null, '', window.location.pathname);
      document.getElementById('project-detail').style.display = 'none';
      document.getElementById('projects-list').style.display = 'block';
    }

    function handleRoute() {
      const hash = window.location.hash.replace('#','');
      if (hash && validSlugs.includes(hash)) {
        showProjectDetail(hash);
      } else {
        document.getElementById('project-detail').style.display = 'none';
        document.getElementById('projects-list').style.display = 'block';
      }
    }

    window.addEventListener('hashchange', handleRoute);
    window.addEventListener('load', handleRoute);

    // Card click → detail
    document.querySelectorAll('.card-clickable').forEach(card => {
      const slug = card.getAttribute('data-slug');
      card.addEventListener('click', (e) => {
        if (e.target.closest('a')) return; // Don't intercept link clicks
        window.location.hash = slug;
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          window.location.hash = slug;
        }
      });
    });

    // IntersectionObserver for sections
    function observeSections(container) {
      const animObs = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); animObs.unobserve(e.target); } });
      }, { threshold: 0.1 });

      const tocLinks = container.querySelectorAll('.pd-toc a');
      const tocObs = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const id = e.target.getAttribute('aria-labelledby');
            if (id) {
              tocLinks.forEach(link => {
                if (link.getAttribute('href') === `#${id}`) link.classList.add('active');
                else link.classList.remove('active');
              });
            }
          }
        });
      }, { rootMargin: '-10% 0px -80% 0px', threshold: 0 });

      container.querySelectorAll('.pd-section').forEach(s => {
        animObs.observe(s);
        tocObs.observe(s);
      });
    }

    // Handle TOC click for smooth scrolling without changing hash (which breaks SPA route)
    document.querySelectorAll('.toc-link').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href').replace('#', '');
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          const offset = targetEl.parentElement.offsetTop; // get section top
          // The h2 is inside the section, scroll to the section top minus some padding
          const y = targetEl.getBoundingClientRect().top + window.scrollY - 80;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      });
    });

    // IntersectionObserver for timeline
    function observeTimeline(container) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
      }, { threshold: 0.2 });
      container.querySelectorAll('.pd-tl-item').forEach(t => obs.observe(t));
    }

    // Make backToProjects globally available
    window.backToProjects = backToProjects;
  </script>
</body>
</html>
